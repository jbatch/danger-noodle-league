# Optional public development hostname. Servers listen on all local interfaces
# when this is set; the hostname itself is not used as a bind address.
# DEV_HOST=dev.jbat.ch
# Additional accepted Host headers, separated by commas.
# DEV_ALLOWED_HOSTS=preview.jbat.ch,another-dev.jbat.ch

# Optional server bindings. The game backend owns the public port and proxies
# ordinary page/HMR traffic to the loopback-only Vite server.
# GAME_HOST=127.0.0.1
# PORT=3000
# FRONTEND_PORT=3001

# Optional durable SQLite account database path. The default is
# data/accounts.sqlite.
# Passwords are salted and hashed; session tokens are stored as SHA-256 hashes.
# ACCOUNTS_DB_FILE=/absolute/path/to/accounts.sqlite
# Legacy JSON is imported transactionally at startup and deleted after a
# successful migration. Override its discovery path only when needed.
# ACCOUNTS_FILE=/absolute/path/to/accounts.json
# Force Secure account cookies when TLS terminates without X-Forwarded-Proto.
# ACCOUNT_COOKIE_SECURE=true

# Optional production origins. Configure NEXT_PUBLIC_SITE_URL as a Docker build
# argument (the publish workflow reads the matching GitHub Actions variable).
# Only set NEXT_PUBLIC_WS_URL at build time if production does not proxy /ws on
# the site origin; the Docker/Caddy setup does not need it.
# NEXT_PUBLIC_WS_URL=wss://your-game-server.example/ws
# NEXT_PUBLIC_SITE_URL=https://your-game.example

# Host port used by docker-compose.yml. The container always listens on 3000.
# DNL_PORT=3000
